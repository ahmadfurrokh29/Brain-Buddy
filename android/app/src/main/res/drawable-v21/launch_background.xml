<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while Brain Bean starts: the splash screen's mint and logo, in the same spot, so the two blend into one. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_mint" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_logo" />
    </item>
</layer-list>
