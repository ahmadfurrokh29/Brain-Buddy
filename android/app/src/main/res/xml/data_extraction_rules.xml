<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup: copies Brain Buddy's data to the user's own Google Drive and restores it on a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
